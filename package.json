{
  "name": "vscode-codelens-refactor",
  "displayName": "CodeLens-Refactor",
  "description": "Displays call-site counts above function declarations and triggers native rename actions.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "CodeLens-Refactor",
      "properties": {
        "codelensRefactor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the CodeLens provider globally."
        },
        "codelensRefactor.languages": {
          "type": "object",
          "default": {
            "typescript": true,
            "typescriptreact": true,
            "javascript": true,
            "javascriptreact": true,
            "python": true
          },
          "description": "Enable or disable lenses per language."
        },
        "codelensRefactor.minCallCount": {
          "type": "number",
          "default": 1,
          "description": "Minimum call count to display the lens. Set to 0 to show all."
        },
        "codelensRefactor.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Debounce interval in milliseconds for call counting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
